# Copy to .env (or set as environment variables on your host).
# All values except APIFY_TOKEN are optional.

# Port the web server listens on (Render/Railway/Fly set this for you).
PORT=3000

# Secret used to sign login cookies. Use a long random string.
SECRET=change-me-to-a-long-random-string

# Token that the external hourly cron (GitHub Actions) uses to trigger polls.
# Keep this secret; anyone with it can force a poll.
POLL_TOKEN=change-me-poll-token

# Your Apify API token (required). Get it at https://console.apify.com/account#/integrations
APIFY_TOKEN=

# Apify actor that scrapes an Instagram profile.
# The official apify/instagram-scraper works without login for public profiles
# and returns the profile card (avatar, bio, counts) for private accounts.
# Free plan: ~300 results/month included; after that it's ~$2.70 per 1000.
APIFY_ACTOR=apify/instagram-scraper

# How often to poll, in hours.
POLL_INTERVAL_HOURS=1

# Private accounts are checked every hour with a lightweight privacy-only ping
# (one batched run covers all private accounts, so it stays cheap). The full
# poll — avatar download, compare, save, notify — runs every POLL_BATCH_HOURS.
# If a private account goes public, it is pulled immediately and you are told
# on Telegram (no manual setup per account).
POLL_BATCH_HOURS=8

# Apify actor that saves stories + highlights.
# oneary/instagram-stories-and-highlights-scraper returns the current active
# stories and permanent highlights. Leave empty to disable story tracking.
APIFY_STORIES_ACTOR=oneary/instagram-stories-and-highlights-scraper

# Proxy group the stories actor should use. Instagram blocks the default proxy,
# so this needs RESIDENTIAL (pay-per-GB, ~$0.45/GB on Apify).
APIFY_STORIES_PROXY=RESIDENTIAL

# Hugging Face: pushes each person's data to a dataset as <user>/ folders.
# Leave empty to disable HF sync.
HF_TOKEN=
HF_DATASET=

# Telegram alerts + daily summary. TELEGRAM_USER_IDS is a comma-separated list.
# Leave empty to disable alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_IDS=

# Render API token (https://dashboard.render.com/u/settings#api-keys).
# Used for Render platform automation. Leave empty to disable.
RENDER_API_KEY=

# Data retention: media files (posts/stories) older than this many days are
# deleted to save storage. Avatars and JSON history are always kept.
RETENTION_DAYS=7

# Hour (0-23, server time) at which the daily Telegram summary is sent.
SUMMARY_HOUR=9

# ---------------------------------------------------------------------------
# Cron-driven operation
# ---------------------------------------------------------------------------

# Set to 1 when an external cron is the only thing that should trigger polls.
# Free hosts (Render free, Koyeb, Fly free) spin the instance down when idle, so
# the in-process timer silently stops firing. With CRON_MODE=1 that timer is
# disabled and one POST /api/poll does the entire cycle in-request:
#   restore state -> fetch -> diff -> save -> alert -> back up
# Leave unset/0 if the process really does stay awake (a VM, a paid dyno).
CRON_MODE=0

# A poll holds a lock so two triggers can never fetch the same profiles twice.
# If a host is killed mid-poll the lock is left behind; it is treated as
# abandoned after this many minutes.
POLL_LOCK_STALE_MINUTES=20

# ---------------------------------------------------------------------------
# Cost control
# ---------------------------------------------------------------------------

# maximum_free   — never exceed a provider's free monthly allowance (default).
# balanced       — allow the configured paid limits for low-cost providers.
# maximum_coverage — allow premium providers too.
BUDGET_MODE=maximum_free

# Apify budget, measured in dataset items ("results"), which is what Apify bills.
# A profile poll returning 20 posts costs ~21 units; a 30-post backfill ~31.
# APIFY_FREE_UNITS is the vendor's free monthly allowance and is the hard
# ceiling in maximum_free mode. APIFY_DAILY_UNITS is only a burst guard — it
# must stay above the biggest single day of work or that work is blocked
# permanently, not just for today.
APIFY_MONTHLY_UNITS=300
APIFY_DAILY_UNITS=60
APIFY_FREE_UNITS=300

# As the monthly budget is consumed, polling intervals stretch automatically
# (x2 at 70%, x4 at 85%, x12 at 95%, stop at 100%) so quota lasts the month.

# Turn an individual provider off without removing its credentials.
PROVIDER_APIFY_ENABLED=1

# Consecutive provider failures before its circuit opens, and how long it stays
# open before one trial request is allowed through. State is persisted, so a
# tripped circuit is still tripped on the next cron invocation.
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_MINUTES=15

# ---------------------------------------------------------------------------
# Backup providers — automatic failover
# ---------------------------------------------------------------------------
# The router tries providers cheapest-tier-first (free -> low_cost -> premium),
# skipping any whose daily/monthly quota is spent or whose circuit is open. So
# when one runs out of credit the next one takes over with no config change.
# A provider with no key is reported as disabled and never chosen — fill in only
# the ones you actually have.
#
# Order for profile data:  rapidapi (free) -> apify -> brightdata -> lobstr
# Order for stories:       rapidapi (free) -> apify

# --- RapidAPI: stories + highlights, and profile as a free backup ------------
# The marketplace has many competing Instagram scrapers on different hosts, so
# the host and paths are configurable. Defaults match instagram-scraper-api2.
# Check your subscription's endpoint list and adjust if they differ.
RAPIDAPI_KEY=
RAPIDAPI_HOST=instagram-scraper-api2.p.rapidapi.com
RAPIDAPI_PROFILE_PATH=/v1/info
RAPIDAPI_STORIES_PATH=/v1/stories
RAPIDAPI_HIGHLIGHTS_PATH=/v1/highlights
RAPIDAPI_USERNAME_PARAM=username_or_id_or_url
# Per-request billing. Keep the monthly value at your plan's real allowance.
RAPIDAPI_MONTHLY_UNITS=500
RAPIDAPI_DAILY_UNITS=16
RAPIDAPI_FREE_UNITS=500

# --- Bright Data: public/private status check --------------------------------
# Dataset IDs are per-account and per-scraper — copy yours from the Web Scraper
# API page for the Instagram profile scraper (looks like gd_xxxxxxxxxxxx).
BRIGHTDATA_API_KEY=
BRIGHTDATA_DATASET_ID=
# Bills per record returned, with no free monthly tier. In BUDGET_MODE=
# maximum_free the ceiling is 0 and Bright Data is skipped entirely; set
# BRIGHTDATA_FREE_UNITS if your plan has trial credit, or use balanced mode.
BRIGHTDATA_FREE_UNITS=0
BRIGHTDATA_MONTHLY_UNITS=5000
BRIGHTDATA_DAILY_UNITS=240

# --- Lobstr.io: last-resort profile backup ----------------------------------
# Create a squid in the dashboard using the Instagram Profile crawler, then put
# its hash id here. Key comes from https://app.lobstr.io/dashboard/api
LOBSTR_API_KEY=
LOBSTR_SQUID_ID=
LOBSTR_FREE_UNITS=0
LOBSTR_MONTHLY_UNITS=1000
LOBSTR_DAILY_UNITS=60

# Turn any backup off without deleting its credentials.
PROVIDER_RAPIDAPI_ENABLED=1
PROVIDER_BRIGHTDATA_ENABLED=1
PROVIDER_LOBSTR_ENABLED=1

RAPIDAPI_KEY=dummy\nHF_TOKEN=dummy\nHF_DATASET=dummy
